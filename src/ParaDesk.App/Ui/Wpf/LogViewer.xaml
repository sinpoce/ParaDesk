<ui:FluentWindow
    x:Class="ParaDesk.Shell.LogViewer"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="运行日志"
    Width="900" Height="620"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/paradesk.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="运行日志" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DocumentText24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 过滤条 -->
        <Grid Grid.Row="1" Margin="16,4,16,10">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox x:Name="TbFilter" Width="260" PlaceholderText="筛选关键字…"
                            TextChanged="OnFilterChanged"/>
                <ComboBox x:Name="CbLevel" Width="130" Margin="8,0,0,0"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部级别"/>
                    <ComboBoxItem Content="INFO 以上"/>
                    <ComboBoxItem Content="WARN 以上"/>
                    <ComboBoxItem Content="仅 ERROR"/>
                </ComboBox>
                <ui:ToggleSwitch x:Name="SwAutoScroll" Margin="12,0,0,0" IsChecked="True"
                                 Content="自动滚动"/>
            </StackPanel>
            <TextBlock x:Name="LblCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Opacity="0.65"/>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,0" CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Padding="10,8">
                <TextBox x:Name="TbLog" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" TextWrapping="NoWrap"
                         FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Padding="16,12,16,16">
            <Grid>
                <TextBlock x:Name="LblPath" VerticalAlignment="Center" Opacity="0.55" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="复制全部" Click="OnCopy" Margin="0,0,8,0"/>
                    <ui:Button Content="清空日志" Click="OnClear" Margin="0,0,8,0"/>
                    <ui:Button Content="关闭" Appearance="Primary" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
