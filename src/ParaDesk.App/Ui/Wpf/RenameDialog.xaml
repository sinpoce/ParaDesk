<ui:FluentWindow
    x:Class="ParaDesk.Shell.RenameDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="重命名显示器"
    Width="460" Height="270"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/paradesk.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="重命名显示器" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Rename24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <TextBlock x:Name="TbSubject" Opacity="0.75" TextWrapping="Wrap"/>
            <ui:TextBox x:Name="TbName" Margin="0,14,0,0"
                        PlaceholderText="例如：左侧竖屏、AI 工作屏"/>
            <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.62" TextWrapping="Wrap"
                       Text="留空即恢复默认名称。名字按显示器接口保存，换分辨率或重新插拔都不会丢。"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,16,24,20">
            <ui:Button Content="取消" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
            <ui:Button Content="确定" MinWidth="88" Appearance="Primary" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
